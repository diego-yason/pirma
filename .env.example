# Drizzle
# Direct (IPv6)
# DATABASE_URL=""
# Pooler (IPv4)
DATABASE_URL=""

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
OPAQUE_SERVER_KEY=

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=""

PUBLIC_MAX_RECIPIENTS = 

# Key settings
KEY_MAX_AGE_DAYS=
KEY_MAX_IDLE_DAYS=
KEY_MAX_SIGNATURES=
KEY_ALLOWED_ALGORITHMS=

# Logging (pino)
# debug | info | warn | error — defaults to info in production, debug otherwise
LOG_LEVEL=

# Email (transactional notifications)
# console = log to server console only (no API key needed, for dev)
# resend  = send via Resend (requires RESEND_API_KEY)
EMAIL_PROVIDER=console
EMAIL_FROM="Pirma <noreply@example.com>"
RESEND_API_KEY=
# Comma-separated days after invite to send reminder emails (default 3,7)
EMAIL_REMIND_DAYS=3,7
# Secret required by /api/cron/reminders (x-cron-secret header). Empty = cron endpoint disabled.
CRON_SECRET=