{
    "name": "pirma",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./src/service-worker/tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write .",
        "test:unit": "vitest",
        "test": "npm run test:unit -- --run && npm run test:e2e",
        "test:e2e": "playwright install && playwright test",
        "test:e2e:dashboard": "playwright test --config=playwright.dashboard.config.ts",
        "test:e2e:documents": "playwright test --config=playwright.documents.config.ts",
        "db:push": "drizzle-kit push",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
        "auth:opaque:generate": "pnpm dlx @serenity-kit/opaque@latest create-server-setup"
    },
    "devDependencies": {
        "@better-auth/cli": "1.4.21",
        "@chromatic-com/storybook": "^5.3.0",
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "@inlang/paraglide-js": "^2.24.1",
        "@playwright/test": "^1.62.1",
        "@storybook/addon-a11y": "^10.5.10",
        "@storybook/addon-docs": "^10.5.10",
        "@storybook/addon-mcp": "^0.6.0",
        "@storybook/addon-svelte-csf": "^5.1.2",
        "@storybook/addon-vitest": "^10.5.10",
        "@storybook/sveltekit": "^10.5.10",
        "@sveltejs/adapter-auto": "next",
        "@sveltejs/kit": "next",
        "@sveltejs/load-config": "^0.2.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^25.9.5",
        "@types/nodemailer": "^8.0.1",
        "@vitest/browser-playwright": "^4.1.11",
        "@vitest/coverage-v8": "^4.1.11",
        "better-auth": "1.6.11",
        "drizzle-kit": "^0.31.10",
        "drizzle-orm": "^0.45.2",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-storybook": "^10.5.10",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.11.0",
        "pino-pretty": "^13.1.3",
        "playwright": "^1.62.1",
        "postgres": "^3.4.9",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "storybook": "^10.5.10",
        "svelte": "^5.56.10",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "vitest-browser-svelte": "^2.2.1"
    },
    "dependencies": {
        "@better-auth/passkey": "1.6.11",
        "@fingerprint/svelte": "^3.0.0",
        "@serenity-kit/opaque": "^1.1.0",
        "@supabase/supabase-js": "^2.112.3",
        "better-auth-opaque": "link:plugins\\better-auth\\opaque",
        "bsrp": "^1.0.9",
        "nodemailer": "^9.0.5",
        "pdf-lib": "^1.17.1",
        "pdfjs-dist": "^6.2.108",
        "pino": "^10.3.1",
        "ua-parser-js": "^2.0.10",
        "zod": "^4.4.3"
    },
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    }
}
