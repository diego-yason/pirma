          "type": "text",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "select distinct \"documents\".\"id\", \"documents\".\"title\", \"documents\".\"status\", \"documents\".\"updated_at\", \"user_keys\".\"user_id\" from \"documents\" inner join \"signatures\" on \"documents\".\"id\" = \"signatures\".\"document_id\" inner join \"user_keys\" on \"signatures\".\"crypto_key\" = \"user_keys\".\"id\" where \"signatures\".\"status\" in ('signed', 'anchored')",
      "name": "completed_documents",
